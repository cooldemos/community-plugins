{
  "name": "@backstage-community/plugin-search-backend-module-typesense",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./hybrid": "./src/hybrid.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "hybrid": [
        "src/hybrid.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/community-plugins",
    "directory": "workspaces/hybrid-search/plugins/search-backend-module-typesense"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "search",
    "pluginPackage": "@backstage/plugin-search-backend"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.0",
    "@backstage/config": "^1.3.7",
    "@backstage/plugin-search-backend-node": "^1.4.3",
    "@backstage/plugin-search-common": "^1.2.23",
    "@backstage/types": "^1.2.2",
    "typesense": "^3.0.6"
  },
  "peerDependencies": {
    "@backstage-community/plugin-search-backend-module-hybrid": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@backstage-community/plugin-search-backend-module-hybrid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@backstage-community/plugin-search-backend-module-hybrid": "workspace:^",
    "@backstage/backend-test-utils": "^1.11.3",
    "@backstage/cli": "^0.36.1"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "moduleNameMapper": {
      "^@google-cloud/discoveryengine(.*)$": "<rootDir>/../../../packages/integration-tests/src/mockDiscoveryEngine",
      "^@google-cloud/storage(.*)$": "<rootDir>/../../../packages/integration-tests/src/mockStorage",
      "^typesense$": "<rootDir>/../../../packages/integration-tests/src/mockTypesense"
    }
  }
}
