{
  "name": "@backstage-community/plugin-spanner-graph-backend",
  "description": "Backstage backend plugin that serves multi-hop Cloud Spanner Graph topology and blast-radius queries over ISO GQL.",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "spanner-graph",
    "pluginPackages": [
      "@backstage-community/plugin-spanner-graph",
      "@backstage-community/plugin-spanner-graph-backend"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/community-plugins",
    "directory": "workspaces/spanner-graph/plugins/spanner-graph-backend"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-defaults": "backstage:^",
    "@backstage/backend-plugin-api": "backstage:^",
    "@backstage/config": "backstage:^",
    "@backstage/errors": "backstage:^",
    "@google-cloud/spanner": "^7.9.0",
    "@google/genai": "^1.41.0",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0",
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "backstage:^",
    "@backstage/cli": "backstage:^",
    "@types/express": "^4.17.13",
    "@types/supertest": "^7.0.0",
    "supertest": "^7.0.0"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts"
}
